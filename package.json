{
  "name": "file-server",
  "version": "1.0.0",
  "description": "A simple file server that serves directory listings",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "npm run build:ui && node server.js",
    "build:ui": "vite build",
    "dev:ui": "vite",
    "dev": "node server.js --port 3000",
    "serve": "node server.js --dir ./files",
    "tunnel": "node tunnel-setup.js",
    "ngrok": "npx ngrok http 6488",
    "localtunnel": "npx localtunnel --port 6488",
    "build": "npm run build:ui && npm run build:linux && npm run build:windows && npm run build:macos",
    "build:linux": "pkg server.js --output dist/FileServer-linux --targets node18-linux-x64",
    "build:windows": "pkg server.js --output dist/FileServer-windows.exe --targets node18-win-x64",
    "build:macos": "pkg server.js --output dist/FileServer-macos --targets node18-macos-x64"
  },
  "keywords": [
    "file-server",
    "static-server",
    "directory-listing",
    "file-browser"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "bootstrap-icons": "^1.13.2",
    "express": "^4.18.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "pkg": "^5.8.1",
    "postcss": "^8.5.30",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "scripts": [
      "server.js"
    ],
    "targets": [
      "node18-linux-x64",
      "node18-win-x64",
      "node18-macos-x64"
    ],
    "outputPath": "dist/"
  }
}
